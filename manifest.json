{
  "manifest_version": 3,
  "name": "豆包小窗",
  "version": "1.0.0",
  "description": "点击工具栏图标,在独立小窗中打开豆包聊天页,再点一次关闭",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开/关闭豆包小窗",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "打开/关闭豆包小窗"
    }
  }
}
